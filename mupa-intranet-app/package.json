{
  "name": "mupa-intranet-app",
  "version": "1.0.0",
  "description": "Intranet de la Alcaldía de Panamá: SPA en React (Vite). La API vive aparte y nginx la reenvía en /api.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "npm run test:int && npm run test:e2e",
    "test:int": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:dist": "cross-env PW_DIST=1 playwright test",
    "migrar:pdfs": "node scripts/descargar-pdfs.mjs",
    "test:e2e:publicacion": "playwright test -c playwright.publicacion.config.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "ogl": "^1.0.11",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.58.2",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "cross-env": "^7.0.3",
    "eslint": "^9.16.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.4.2",
    "typescript": "5.7.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": ">=20.19"
  }
}
