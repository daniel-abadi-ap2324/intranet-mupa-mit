# ============================================================================
# API de la intranet, SIN Docker (`npm run dev`)
#
#   1) cp .env.example .env          (el .env nunca va a git)
#   2) npm install
#   3) npm run dev                   →  http://localhost:3000/api/health
#
# Tal como está, arranca sola en tu equipo: base PGlite en ./.data (sin instalar
# PostgreSQL), se prepara al arrancar y trae cuentas ficticias. Para la web:
# mupa-intranet-app (npm run dev, http://localhost:5173) ya reenvía /api a este puerto.
# Con Docker no se usa este archivo: se usa el .env de la raíz (junto a docker-compose.yml).
# ============================================================================


# ---------- 1. Modo ----------------------------------------------------------
# development en tu equipo. production en un servidor: ahí exige DATABASE_URL,
# no permite las cuentas ficticias y pide Identity Central por https.
NODE_ENV=development
PORT=3000


# ---------- 2. Base de datos y archivos -------------------------------------
# Sin DATABASE_URL se usa PGlite: un PostgreSQL real guardado en PGLITE_DATA_DIR.
# Para un PostgreSQL propio: postgres://usuario:clave@servidor:5432/base
# DATABASE_URL=
# PGLITE_DATA_DIR=./.data/pglite
# PDF e imágenes que sube Comunicación (boletines, noticias). Respaldar junto con la base.
# UPLOADS_DIR=./.data/uploads

# Al arrancar: aplica las migraciones y carga los datos iniciales (catálogo, formularios, contenido).
DB_AUTO_SETUP=true


# ---------- 3. Cómo se entra --------------------------------------------------
# Cuentas FICTICIAS (contraseña "password"): admin@ejemplo.test, comunicacion@ejemplo.test,
# gestor@ejemplo.test, prueba1@ejemplo.test y prueba2@ejemplo.test.
# Nunca en un servidor real: con NODE_ENV=production la API no arranca con esto en true.
SEED_DEMO_USERS=true
LOCAL_LOGIN_ENABLED=true

# Cookie de sesión solo por HTTPS. Por defecto: false en development, true en production.
# COOKIE_SECURE=false
# Duración de la sesión, en horas.
SESSION_TTL_HOURS=8

# Identity Central (login de la Alcaldía). Opcional en tu equipo; obligatorio en un servidor.
# Solo responde desde la red de la Alcaldía. Los valores los da el equipo de Identity Central
# (equipo de Identity Central); guía: GUIA_INTEGRACION_IDENTITY_PASSWORD.md y README.md de esta carpeta.
# Si pones IDENTITY_URL, las cinco siguientes son obligatorias.
# IDENTITY_URL=https://servidor-de-identity
# IDENTITY_CLIENT_ID=intranet_ejemplo
# Secreto: solo aquí o en el servidor. Nunca en git, en el frontend ni en un correo.
# IDENTITY_CLIENT_SECRET=
# El issuer se compara carácter por carácter: termina en "/".
# JWT_ISSUER=https://servidor-de-identity/
# JWT_JWKS_URI=https://servidor-de-identity/.well-known/jwks
# client_id aceptados, separados por coma. Debe incluir IDENTITY_CLIENT_ID.
# ALLOWED_CLIENT_IDS=intranet_ejemplo
# Opcionales. NO agregues phone ni address: no existen en el servidor y rompen todo login.
# IDENTITY_SCOPES=openid profile email offline_access roles
# IDENTITY_TIMEOUT_MS=10000
# Cuenta de servicio de la API en Identity Central (la da DITI; con permiso de quitar acceso a una aplicación).
# Con ella, «Borrar» en /gestion/usuarios le quita a la persona el acceso a la intranet en el central.
# Sin ella, solo se bloquea y se borra en la intranet. Van juntas.
# IDENTITY_ADMIN_USER=
# IDENTITY_ADMIN_PASSWORD=


# ---------- 4. Opcionales ------------------------------------------------------
# Asistente de búsqueda: servidor de inferencia de la Alcaldía (API compatible con OpenAI; la
# dirección la da DITI y solo responde desde su red). Sin LLM_URL el asistente queda apagado
# (el Inicio no ofrece "Preguntar al asistente") y todo lo demás funciona igual.
# LLM_URL=http://servidor-de-inferencia:puerto
# Sin LLM_MODEL se usa el único modelo que tenga cargado el servidor.
# LLM_MODEL=
# LLM_TIMEOUT_MS=30000

# Sistema de citas de la Clínica (se lee su catálogo público: especialidades y días).
# Si no responde, la página de la Clínica muestra una copia guardada.
# CLINIC_URL=https://clinica.mupa.gob.pa
# CLINIC_TIMEOUT_MS=5000

# API de la Clínica para otros sistemas (historial de citas por cédula, llave en X-Api-Key). Con ellas, «Mis citas»
# aparece en la página de la Clínica. Dirección interna y llave: nunca en git. Van juntas. Sin ellas no aparece.
# CLINIC_API_URL=http://servidor-de-la-clinica:puerto
# CLINIC_API_KEY=

# API de códigos de llamada (solicitudes de PIN de línea, por cédula; solo lectura; llave en X-Api-Key). La URL es la base, sin
# la ruta. Dirección interna y llave: nunca en git. Van juntas. Sin ellas no aparecen en Mis solicitudes.
# CALLCODE_API_URL=http://servidor-de-codigos:puerto
# CALLCODE_API_KEY=

# Mesa de Ayuda (GLPI), solo lectura: los tickets de cada persona en «Mis solicitudes». La persona se busca por su cédula
# en el campo «Teléfono» de su usuario de GLPI. La URL es la de la API REST (termina en /apirest.php). La cuenta de consulta
# entra con su token de API (recomendado) o con usuario y contraseña (GLPI_USER_ID es el usuario). Nunca en git.
# GLPI_API_URL=http://servidor-glpi/apirest.php
# GLPI_APP_TOKEN=
# GLPI_USER_TOKEN=
# GLPI_USER_ID=
# GLPI_USER_PASS=

# RH Link (backend de RRHH Express). Con él, la pestaña Recursos Humanos deja que cada persona
# conecte su cuenta de RRHH Express (cédula y contraseña) y vea sus marcaciones, comprobantes,
# expediente y tiempo compensatorio. Dirección interna (la da quien mantiene RH Link): nunca en git.
# Sin RRHH_API_URL esa parte no aparece y los datos laborales siguen «Próximamente».
# RRHH_API_URL=http://servidor-de-rh-link:puerto
# RRHH_TIMEOUT_MS=10000
# Verificación al entrar: con la cuenta de AD de la API, RH Link dice si la cédula es de un funcionario ACTIVO
# (GET empleados/cedula/:cedula); si no, no se entra ni se registra. Las dos van juntas y piden RRHH_API_URL.
# Sin ellas no se verifica. Las cuentas de prueba (LOCAL_LOGIN_ENABLED) no pasan por esto.
# RRHH_API_USER=
# RRHH_API_PASSWORD=
# Al registrarse el nombre sale de RH Link: «nombres-primero» (por defecto) o «apellidos-primero» (así viene en la planilla).
# RRHH_NOMBRE_ORDEN=nombres-primero
# Registro: solo correos institucionales de estos dominios (sin @, separados por coma).
# CORREO_DOMINIOS=pty.gob.pa

# Central telefónica (Grandstream UCM, API HTTPS): el Directorio se compara con sus extensiones al arrancar y cada
# UCM_SYNC_MINUTOS (0 = nunca sola). Solo lectura. Dirección, usuario y contraseña: solo en el .env, nunca en git.
# Si la central rechaza el usuario o la contraseña, no se reintenta hasta reiniciar la API (evita bloquear la cuenta).
# UCM_TLS_VERIFICAR=false acepta su certificado autofirmado, solo en ese cliente.
# UCM_URL=
# UCM_USER=
# UCM_PASSWORD=
# UCM_SYNC_MINUTOS=60
# UCM_TLS_VERIFICAR=true

# Sincronización con mupa.gob.pa (WordPress): trae solas las noticias (solo EDICION=completa) y los
# boletines «AlcalDía» nuevos, con su PDF y su portada. Solo LEE páginas públicas del sitio.
# Sin WP_SYNC_URL está apagada (y el botón «Sincronizar ahora» no aparece).
# WP_SYNC_URL=https://mupa.gob.pa
# WP_SYNC_INTERVAL_MINUTES=60
# WP_SYNC_WINDOW_DAYS=90
# WP_SYNC_CATEGORIES=
# WP_SYNC_TIMEOUT_MS=15000

# Servidor MCP (mupa-intranet-mcp, Python): describe los endpoints y las páginas de la intranet para el asistente.
# MCP_INTERNAL_KEY: llave compartida con el MCP (al menos 16 caracteres). Con ella existe GET /api/meta/catalog, que
#   solo entrega el catálogo a quien mande esa llave en la cabecera X-Internal-Key. Sin ella esa ruta no existe (404).
# MCP_URL: dónde está el MCP (…/mcp). Con él, el asistente le pide pistas antes de responder; si no responde, sigue sin ellas.
# MCP_INTERNAL_KEY=
# MCP_URL=http://localhost:8000/mcp
# MCP_TIMEOUT_MS=2000
