# Para las pruebas de punta a punta del frontend (`npm run e2e:serve`):
# base en memoria, nueva en cada arranque, con los datos iniciales y las cuentas ficticias.
PORT=3000
PGLITE_DATA_DIR=memory://
DB_AUTO_SETUP=true
SEED_DEMO_USERS=true
LOCAL_LOGIN_ENABLED=true
# Archivos subidos en las pruebas (se borran con la carpeta .data).
UPLOADS_DIR=./.data/uploads-e2e
# Sin red en las pruebas: el catálogo de la Clínica cae a la copia de respaldo.
CLINIC_URL=http://127.0.0.1:9
CLINIC_TIMEOUT_MS=500
# Las pruebas e2e simulan RRHH Express con page.route; la página en mantenimiento tiene su propia prueba.
RRHH_MANTENIMIENTO=false
