{
  "name": "mupa-intranet-api",
  "version": "1.0.0",
  "description": "Backend de la Intranet de la Alcaldía de Panamá: Express + Drizzle + PostgreSQL. Convenciones en CONVENTIONS.md.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --watch --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/database/migrate.ts",
    "catalogo:exportar": "node --disable-warning=ExperimentalWarning scripts/exportar-catalogo.ts",
    "db:seed": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/database/seed.ts",
    "e2e:serve": "node --disable-warning=ExperimentalWarning --env-file=.env.e2e src/server.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.10",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.11.2",
    "jose": "^6.2.12",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.3.0",
    "typescript": "~5.9",
    "vitest": "^5.0.1"
  }
}
