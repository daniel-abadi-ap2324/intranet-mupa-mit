# ============================================================================
# Intranet MUPA · configuración de `docker compose` (PostgreSQL + API + web)
#
# Para probar en tu equipo NO hace falta este archivo:
#   docker compose up --build     →  http://localhost:8080
# El compose ya trae los valores de demostración local (los de abajo).
#
# Para cambiar algo: cp .env.example .env (el .env nunca va a git) y edita.
# Para un servidor real: usa la columna "servidor" del bloque 1 y completa el bloque 3.
#
# Sin Docker (cada proyecto por su lado) no se usa este archivo:
#   mupa-intranet-api/.env.example  y  mupa-intranet-app/.env.example
# ============================================================================


# ---------- 1. Modo ----------------------------------------------------------
#                            local          servidor
NODE_ENV=development       # development    production
COOKIE_SECURE=false        # false          true      (true = la cookie de sesión solo viaja por HTTPS)
SEED_DEMO_USERS=true       # true           false     (crea las cuentas ficticias, ver abajo)
LOCAL_LOGIN_ENABLED=true   # true           false     (se puede entrar con esas cuentas)
EDICION=completa           # completa       publicacion (publicacion = sin anuncios, videos ni contenido
#                                                        del Inicio en gestión; ver src/lib/edicion.ts)
#
# Cuentas ficticias (contraseña "password"): admin@ejemplo.test, comunicacion@ejemplo.test,
# gestor@ejemplo.test, prueba1@ejemplo.test y prueba2@ejemplo.test. Con NODE_ENV=production
# la API NO arranca si SEED_DEMO_USERS o LOCAL_LOGIN_ENABLED están en true.
# SEED_DEMO_USERS se aplica en el primer `up` (el seed solo agrega lo que falta).


# ---------- 2. Base de datos -------------------------------------------------
# La contraseña va dentro de la URL de conexión: solo letras y números.
# La de abajo sirve solo para probar en tu equipo. En un servidor: openssl rand -hex 24
POSTGRES_PASSWORD=solo-local-demo
POSTGRES_DB=intranet
POSTGRES_USER=intranet


# ---------- 3. Login de la Alcaldía: Identity Central -------------------------
# SERVIDOR: OBLIGATORIO (sin esto y sin cuentas locales, la API no arranca: nadie podría entrar).
# LOCAL: opcional. Vacío = solo entran las cuentas ficticias. Solo responde desde la red de la Alcaldía.
# Los valores los da el equipo de Identity Central. Detalles: mupa-intranet-api/README.md.
# En producción IDENTITY_URL, JWT_ISSUER y JWT_JWKS_URI tienen que ser https://.
IDENTITY_URL=
IDENTITY_CLIENT_ID=
# Secreto: solo aquí o en el servidor. Nunca en git, en el frontend ni en un correo.
IDENTITY_CLIENT_SECRET=
# El issuer se compara carácter por carácter: termina en "/".
JWT_ISSUER=
JWT_JWKS_URI=
# client_id cuyos tokens se aceptan, separados por coma. Debe incluir IDENTITY_CLIENT_ID.
ALLOWED_CLIENT_IDS=
# Opcionales. Por defecto: "openid profile email offline_access roles" (nunca phone ni address) y 10000 ms.
IDENTITY_SCOPES=
IDENTITY_TIMEOUT_MS=
# Cuenta de servicio de la API en Identity Central (la da DITI): con ella, «Borrar» le quita a la persona el acceso a la intranet allá. Van juntas; sin ellas solo se bloquea y borra aquí.
IDENTITY_ADMIN_USER=
IDENTITY_ADMIN_PASSWORD=


# ---------- 4. Opcionales ------------------------------------------------------
# Puerto del sitio (web y /api, los sirve la API) en tu equipo o en el servidor (por defecto 8080).
WEB_PORT=8080
# 1 si el nginx del servidor publica la intranet con su dominio (para leer la IP real de X-Forwarded-For);
# 0 (por defecto) si la gente entra directo al puerto: así nadie puede cambiar su IP para saltarse el límite del login.
TRUST_PROXY=0
# Duración de la sesión, en horas (por defecto 8).
SESSION_TTL_HOURS=8

# Asistente de búsqueda: servidor de inferencia de la Alcaldía (la dirección la da DITI).
# Vacío = asistente apagado: el Inicio no ofrece "Preguntar al asistente" y todo lo demás funciona igual.
LLM_URL=
# Sin LLM_MODEL se usa el único modelo que tenga cargado el servidor. Espera por defecto: 30000 ms.
LLM_MODEL=
LLM_TIMEOUT_MS=

# Sistema de citas de la Clínica (se lee su catálogo público). Vacío = https://clinica.mupa.gob.pa.
# Si no responde, la página de la Clínica muestra una copia guardada. Espera por defecto: 5000 ms.
CLINIC_URL=

# API de la Clínica para otros sistemas: con ellas, «Mis citas» (en la página de la Clínica) trae las citas de cada
# persona por la cédula con la que entró. Dirección interna y llave (X-Api-Key): nunca en git. Vacías = apagado.
CLINIC_API_URL=
CLINIC_API_KEY=

# API de códigos de llamada: las solicitudes de PIN de cada persona (en Mis solicitudes), por la cédula con la que entró.
# CALLCODE_API_URL es la dirección base, sin la ruta (la API agrega /api/external/pin-requests). Dirección interna y
# llave (X-Api-Key): nunca en git. Van juntas. Vacías = apagado.
CALLCODE_API_URL=
CALLCODE_API_KEY=

# Mesa de Ayuda (GLPI), solo lectura: los tickets de cada persona en Mis solicitudes. La persona se busca por su cédula
# en el campo «Teléfono» de su usuario de GLPI. GLPI_API_URL es la de la API REST (termina en /apirest.php). La cuenta de
# consulta entra con su token de API (GLPI_USER_TOKEN, recomendado) o con GLPI_USER_ID (el usuario) y GLPI_USER_PASS.
# Nunca en git. Vacías = apagado.
GLPI_API_URL=
GLPI_APP_TOKEN=
GLPI_USER_TOKEN=
GLPI_USER_ID=
GLPI_USER_PASS=

# RH Link (RRHH Express): con esto, cada persona conecta su cuenta en Recursos Humanos y ve sus marcaciones,
# comprobantes, expediente y tiempo compensatorio. Dirección interna (la da quien mantiene RH Link): nunca en git.
# Vacío = apagado: los datos laborales siguen «Próximamente». Espera por defecto: 10000 ms.
RRHH_API_URL=
RRHH_TIMEOUT_MS=
# Verificación al entrar: con la cuenta de AD de la API, RH Link dice si la cédula es de un funcionario ACTIVO;
# si no, no se entra (ni se registra). Secretos: solo aquí o en el servidor, nunca en git. Vacías = no se verifica.
# Hace falta RRHH_API_URL. Las cuentas de prueba (LOCAL_LOGIN_ENABLED) no pasan por esto.
RRHH_API_USER=
RRHH_API_PASSWORD=
# Al registrarse el nombre sale de RH Link («JUAN CARLOS PEREZ GOMEZ»): ¿viene «nombres-primero» (por defecto) o «apellidos-primero»?
RRHH_NOMBRE_ORDEN=
# Registro: solo correos de estos dominios (sin @, separados por coma). Vacío = pty.gob.pa.
CORREO_DOMINIOS=

# Central telefónica (Grandstream UCM, API HTTPS; Integraciones > Configuración de API en la central): el Directorio
# se compara con sus extensiones al arrancar y cada UCM_SYNC_MINUTOS (60 por defecto; 0 = nunca sola). Solo lectura.
# Dirección (https://…:8089), usuario y contraseña de la API: solo aquí o en el servidor, nunca en git.
# UCM_TLS_VERIFICAR=false acepta el certificado autofirmado de la central (solo en ese cliente).
UCM_URL=
UCM_USER=
UCM_PASSWORD=
UCM_SYNC_MINUTOS=
UCM_TLS_VERIFICAR=

# Sincronización con mupa.gob.pa: noticias y boletines «AlcalDía» nuevos, cada
# WP_SYNC_INTERVAL_MINUTES, mirando los últimos WP_SYNC_WINDOW_DAYS días. Solo lee. Vacío = apagada.
# WP_SYNC_CATEGORIES: IDs de categorías de WordPress (separados por coma) para las noticias; vacío = todas.
WP_SYNC_URL=
WP_SYNC_INTERVAL_MINUTES=
WP_SYNC_WINDOW_DAYS=
WP_SYNC_CATEGORIES=
WP_SYNC_TIMEOUT_MS=

# Servidor MCP (servicio `mcp`, Python): describe los endpoints y las páginas de la intranet para el asistente.
# MCP_INTERNAL_KEY: llave compartida entre la API y el MCP (la misma para los dos, al menos 16 caracteres; la API solo
#   entrega su catálogo a quien la presente). Genera una:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
#   Vacía = la API no entrega su catálogo y el MCP usa su copia de respaldo (solo para desarrollo).
# MCP_URL: no hace falta; ya apunta al servicio. Ponlo vacío (MCP_URL=) para que el asistente no le pida pistas.
MCP_INTERNAL_KEY=
CLINIC_TIMEOUT_MS=
