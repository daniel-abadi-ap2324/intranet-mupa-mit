# ============================================================================
# Intranet MUPA · desarrollo con docker-compose.dev.yml (base de datos en OTRO servidor)
#
#   1) cp .env.dev.example .env.dev      (el .env.dev nunca va a git)
#   2) completa DATABASE_URL y, si hace falta, los puertos
#   3) docker compose -f docker-compose.dev.yml --env-file .env.dev up --build
# ============================================================================

# ---------- Puerto (cámbialo si el servidor no lo tiene libre) ----------
# Puerto del servidor donde se abre la intranet (web y /api):  http://<servidor>:WEB_PORT
WEB_PORT=8080
# 1 si el nginx del servidor publica la intranet con su dominio (para leer la IP real); 0 si se entra directo al puerto.
TRUST_PROXY=0

# ---------- Base de datos externa (OBLIGATORIO) ----------
# postgres://usuario:clave@servidor:5432/base
DATABASE_URL=

# ---------- Modo ----------
NODE_ENV=development
EDICION=publicacion          # publicacion | completa
# Sin HTTPS delante, la cookie de sesión tiene que poder viajar por http.
COOKIE_SECURE=false
# Cuentas ficticias de prueba (contraseña "password"): solo para probar, nunca con datos reales.
SEED_DEMO_USERS=false
LOCAL_LOGIN_ENABLED=false
SESSION_TTL_HOURS=8

# ---------- Login de la Alcaldía (Identity Central) ----------
IDENTITY_URL=
IDENTITY_CLIENT_ID=
IDENTITY_CLIENT_SECRET=
IDENTITY_SCOPES=
IDENTITY_TIMEOUT_MS=
# Con la barra final.
JWT_ISSUER=
JWT_JWKS_URI=
ALLOWED_CLIENT_IDS=

# Cuenta de servicio del central para revocar el acceso al borrar una cuenta (van juntas; vacías = solo se bloquea en la intranet).
IDENTITY_ADMIN_USER=
IDENTITY_ADMIN_PASSWORD=

# ---------- Opcionales (vacías = apagado) ----------
# Mismo significado que en .env.example (ahí está la explicación de cada una). Secretos y direcciones internas: solo aquí.
# Asistente de búsqueda (servidor de inferencia)
LLM_URL=
LLM_MODEL=
LLM_TIMEOUT_MS=
# Clínica: catálogo público y «Mis citas» por cédula (CLINIC_API_URL y CLINIC_API_KEY van juntas)
CLINIC_URL=
CLINIC_TIMEOUT_MS=
CLINIC_API_URL=
CLINIC_API_KEY=
# Códigos de llamada: solicitudes de PIN por cédula (URL base, sin la ruta; van juntas)
CALLCODE_API_URL=
CALLCODE_API_KEY=
CALLCODE_TIMEOUT_MS=
# RH Link: RRHH Express y verificación de funcionario activo al entrar (usuario y contraseña van juntos)
RRHH_API_URL=
RRHH_TIMEOUT_MS=
RRHH_API_USER=
RRHH_API_PASSWORD=
RRHH_NOMBRE_ORDEN=
# Sincronización de noticias y boletines con mupa.gob.pa (solo lectura)
WP_SYNC_URL=
WP_SYNC_INTERVAL_MINUTES=
WP_SYNC_WINDOW_DAYS=
WP_SYNC_CATEGORIES=
WP_SYNC_TIMEOUT_MS=
# Servidor MCP del asistente: la misma llave para la API y el MCP (al menos 16 caracteres)
MCP_INTERNAL_KEY=
